# Structs Network
NETWORK_VERSION=116b
NETWORK_CHAIN_ID=structstestnet-111
STRUCTSD_ARGUMENTS=--log_level info

# Network Resources
STRUCTS_NODE_API_SEED=https://public.testnet.structs.network
STRUCTS_RPC_SEED=https://public.testnet.structs.network:26657
STRUCTS_RPC_PRIMARY=http://structsd:26657
# Optional sync-state LCD override. Defaults to STRUCTS_NODE_API_SEED so
# native staking snapshots work while the local node is still catching up.
# Use http://structsd:1317 only when that node can serve the indexed height.
# STRUCTS_API_URL=http://structsd:1317

# Guild Stack Config
WEBAPP_SOURCE=../structs-webapp/src
PROXY_HTTP_PORT=80
DIRECT_WEBAPP_HTTP_PORT=8080
DIRECT_WEBAPP_HTTPS_PORT=443
DIRECT_POSTGRES_PORT=5432
WEBAPP_APP_ENV=dev
WEBAPP_APP_DEBUG=3
WEBAPP_APP_SECRET=<generate-a-strong-random-secret>

# Optional admin SPA (enable with --profile control or COMPOSE_PROFILES=control)
CONTROL_SOURCE=../structs-control
DIRECT_CONTROL_HTTP_PORT=8081
CONTROL_DEV_GALLERY=
CONTROL_CHOKIDAR_POLLING=true
STRUCTS_CONTROL_MODE=dev

# Database Config
DATABASE_NAME=structs
AUTO_MIGRATE_SLEEP=120
SQITCH_PG_CONNECTION=postgres://structs@structs-pg:5432/structs
STRUCTS_PG_BRANCH=main
STRUCTS_PG_MIGRATION_TARGET=latest
# Set both only for a coordinated existing-database upgrade (see README).
STRUCTS_LEDGER_WRITER_CONTRACT=
STRUCTS_SIGNER_CONTRACT=
# All PG services, including sync-state, use this image.
STRUCTS_PG_IMAGE=structs/structs-pg:latest
POSTGRES_MEMORY_MB=4096

# Sync-state catch-up: concurrent block fetches and blocks per transaction.
# Try 16 fetches when RPC fetching limits progress; compare committed height
# per elapsed second before increasing further. Each block uses two RPC calls.
SYNC_PARALLELISM=8
SYNC_STATE_BULK_WINDOW=500

# Seconds allowed for GRASS delivery, then Docker's outer probe timeout.
GRASS_HEALTH_TIMEOUT=15
GRASS_HEALTHCHECK_TIMEOUT=25s

# Signer
TSA_DATABASE_URL=postgres://structs_tsa@structs-pg:5432/structs?sslmode=require
TSA_WORKERS=6
TSA_GAS_PRICE=
TSA_RPC_URL=http://structsd:26657
TSA_LCD_URL=http://structsd:1317
# Trusted fallback pair while the local node is unavailable or catching up.
# Set BOTH fallback values empty to require the primary pair only.
TSA_RPC_FALLBACK_URL=https://public.testnet.structs.network:26657
TSA_LCD_FALLBACK_URL=https://public.testnet.structs.network


# Node Details
## A single string without spaces denoting the node identifier
MONIKER=

# Validation Details
GUILD_MNEMONIC=
VALIDATOR_INITIAL_STAKING_AMOUNT=50000000
VALIDATOR_IDENTITY=
VALIDATOR_COMMISSION_RATE=0.10
VALIDATOR_MAX_RATE=0.20
VALIDATOR_MAX_CHANGE_RATE=0.01
VALIDATOR_MIN_SELF_DELEGATION=1


# Guild Details
GUILD_ID=
GUILD_NAME=
GUILD_DESCRIPTION=
GUILD_TAG=
GUILD_LOGO=
GUILD_SOCIALS={"twitter":"","facebook":"","farcaster":""}
GUILD_WEBSITE=
GUILD_CONTACT=

## Denominations Power:Label
### 0=Smallest Value
### Ex... {"0": "penny",  "3": "dollar"}
###       {"0": "ualpha", "6": "alpha"}
###       {"0": "uatom",  "6": "atom"}
GUILD_DENOM={"0": "utoken", "6": "token"}


# Discord Details
DISCORD_CLIENT_ID=
DISCORD_TOKEN=

# MCP
MCP_DANGER=true
